# Postgres connection used by the API and by Alembic migrations.
DATABASE_URL=postgresql+psycopg://savethedate:savethedate@localhost:5434/savethedate

# Public base URL used to build invite links (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated CORS origins for the future web client.
CORS_ORIGINS=http://localhost:3000

# Host registration is CLOSED unless this is set, and a caller must then present the
# same value. Generate one with `python -c "import secrets; print(secrets.token_urlsafe(32))"`,
# register the single host, then unset it again. NEVER commit a real value — this
# repository is public.
# HOST_REGISTRATION_TOKEN=

# Left unset, the session cookie's Secure flag follows PUBLIC_BASE_URL: on for https,
# off for local http, where a Secure cookie would never be sent back.
# SESSION_COOKIE_SECURE=
