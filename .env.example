# Postgres connection used by the API and by Alembic migrations.
DATABASE_URL=postgresql+psycopg://savethedate:savethedate@localhost:5434/savethedate

# Public base URL used to build invite links (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated CORS origins for the future web client.
CORS_ORIGINS=http://localhost:3000

# Hostnames whose ROOT serves the save-the-date card instead of the wedding welcome
# (TAP-7781). Unset, every hostname serves the welcome, which is the safe direction.
# `/save-the-date` serves the card on every hostname regardless, which is what local
# review and the visual tests use.
# SAVE_THE_DATE_HOSTS=savethedate.tapphouse.co,dev-savethedate.tapphouse.co

# Host registration is CLOSED unless this is set, and a caller must then present the
# same value. Generate one with `python -c "import secrets; print(secrets.token_urlsafe(32))"`,
# register the single host, then unset it again. NEVER commit a real value — this
# repository is public.
# HOST_REGISTRATION_TOKEN=

# Left unset, the session cookie's Secure flag follows PUBLIC_BASE_URL: on for https,
# off for local http, where a Secure cookie would never be sent back.
# SESSION_COOKIE_SECURE=

# Throttle on the public guest routes, per address per window (TAP-7727).
# INVITE_RATE_LIMIT=60
# INVITE_RATE_WINDOW_SECONDS=60

# Header holding the real client address when behind a proxy, e.g. CF-Connecting-IP.
# Set this ONLY if the proxy overwrites it on every request — a header a caller can
# set is an unlimited supply of fresh buckets, which turns the limiter off.
# TRUSTED_CLIENT_IP_HEADER=

# Email delivery (TAP-7731). "console" prints instead of sending, which is the safe
# default: an unconfigured deployment that prints is obvious, one that silently
# succeeds is a lie, and one that mails real guests by accident is worse than either.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Lisa and Bill <invites@example.com>

# Shared secret for the provider's bounce/complaint webhook. Unset means the webhook
# refuses everything, which is right for an endpoint that rewrites delivery state.
# EMAIL_WEBHOOK_SECRET=
