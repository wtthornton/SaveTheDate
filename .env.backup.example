# Off-machine backup credentials. TAP-7733 item 5.
#
# Copy to `.env.backup`, fill in, `chmod 600`, and NEVER commit it — `.gitignore`
# already refuses the real file, and this repository is public.
#
# Destination: Cloudflare R2, on the same account that holds the tapphouse.co zone
# and the tunnel. Chosen because 10 GB-month of Standard storage is free and egress
# costs nothing, which matters here specifically: the deliverable is a RESTORE that
# is actually performed, and a restore drill that costs money is a drill that stops
# being run.
#
# The trade being accepted: the domain, the tunnel and the backups then depend on
# one Cloudflare account, so an account lockout takes all three. If that ever looks
# too concentrated, point BACKUP_REMOTE at a second provider — nothing else in
# `scripts/backup.sh` or `scripts/restore-drill.sh` is R2-specific, because both go
# through rclone.
#
# -- Creating the bucket and the token --------------------------------------
#
#   1. Cloudflare dashboard -> R2 -> Create bucket -> `savethedate-backups`.
#      Location hint: North America East. Leave public access OFF.
#   2. R2 -> API -> Manage API tokens -> Create Account API token.
#      Permission: "Object Read & Write", scoped to THAT BUCKET ONLY.
#      A token that can reach every bucket on the account is a bigger blast radius
#      than this job needs.
#   3. Copy the Access Key ID, the Secret Access Key, and the S3 endpoint
#      (https://<account-id>.r2.cloudflarestorage.com) into the lines below.
#
# The secret is shown ONCE. If it is lost, delete the token and make another —
# rotating costs nothing here, and the next backup run proves the new one works.

# rclone reads its whole configuration from the environment, so there is no
# rclone.conf to keep in step with this file. "r2" is the remote's name and is what
# BACKUP_REMOTE refers to below.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private
# R2 rejects the bucket-existence probe rclone makes by default against some tokens,
# and the bucket is created by hand above anyway.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Where dumps go. `scripts/backup.sh` writes to <remote>/daily/ and
# `scripts/restore-drill.sh` reads the newest file back from the same place.
BACKUP_REMOTE=r2:savethedate-backups

# Optional. Defaults to 365 — a year of daily dumps, which spans the whole RSVP
# window and is a rounding error against the free tier at a few hundred KB a dump.
# BACKUP_RETENTION_DAYS=365
