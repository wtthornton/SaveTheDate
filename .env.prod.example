# The production environment. TAP-7733.
#
# Copy to `.env.prod`, fill in, and NEVER commit it — `.gitignore` already refuses
# the real file, and this repository is public.
#
# Only secrets live here. Every non-secret production setting — PUBLIC_BASE_URL,
# SAVE_THE_DATE_HOSTS, TRUSTED_CLIENT_IP_HEADER, REVIEW_INSTANCE, EMAIL_PROVIDER —
# is written into `docker-compose.prod.yml` instead, where it is committed,
# reviewable, and asserted by `tests/test_production_stack.py`. A setting that can
# be forgotten eventually is.

# Postgres superuser password for the production database. Nothing off this box can
# reach the database — `db` publishes no port — but this value is also what
# `scripts/backup.sh` and the restore drill authenticate with.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Host port for the app, on 127.0.0.1 only. The tunnel's ingress in
# ~/.cloudflared/config.yml must name the same number. Defaults to 8100 if unset;
# set it explicitly if 8100 is ever taken.
# APP_PORT=8100

# Host registration is CLOSED unless this is set, and a caller must then present the
# same value. Set it, run ONE registration to create Lisa and Bill's host account,
# then delete this line and `scripts/prod.sh deploy` again.
#
# Leaving it set means anyone who finds /auth/register on a public hostname can
# create events on the wedding's own database.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# HOST_REGISTRATION_TOKEN=
